{
  "headers": [
    {
      "source": "/audio/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Type",
          "value": "audio/mpeg"
        }
      ]
    },
    {
      "source": "/downloads/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"pad-ratnakar.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/android",
      "destination": "/android/index.html"
    },
    {
      "source": "/pad/:id",
      "destination": "/index.html"
    },
    {
      "source": "/shodash/:id",
      "destination": "/index.html"
    },
    {
      "source": "/jayanti/:id",
      "destination": "/index.html"
    },
    {
      "source": "/kallolini/:id",
      "destination": "/index.html"
    },
    {
      "source": "/rkk/:id",
      "destination": "/index.html"
    },
    {
      "source": "/madhupark/:id",
      "destination": "/index.html"
    }
  ]
}
