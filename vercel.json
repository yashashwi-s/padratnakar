{
  "headers": [
    {
      "source": "/audio/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Type",
          "value": "audio/mpeg"
        }
      ]
    },
    {
      "source": "/downloads/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"pad-ratnakar.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/support",
      "destination": "/support/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/android",
      "destination": "/android/index.html"
    },
    {
      "source": "/ios",
      "destination": "/ios/index.html"
    },
    {
      "source": "/pad/:id",
      "destination": "/index.html"
    },
    {
      "source": "/shodash/:id",
      "destination": "/index.html"
    },
    {
      "source": "/jayanti/:id",
      "destination": "/index.html"
    },
    {
      "source": "/kallolini/:id",
      "destination": "/index.html"
    },
    {
      "source": "/rkk/:id",
      "destination": "/index.html"
    },
    {
      "source": "/madhupark/:id",
      "destination": "/index.html"
    },
    {
      "source": "/pad-ratnakar/:id",
      "destination": "/index.html"
    },
    {
      "source": "/shodash-geet/:id",
      "destination": "/index.html"
    },
    {
      "source": "/bhaiji-jayanti/:id",
      "destination": "/index.html"
    },
    {
      "source": "/mahabhav-kallolini/:id",
      "destination": "/index.html"
    },
    {
      "source": "/radhakripakataksh",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/pad/:id",
      "destination": "/pad-ratnakar/:id",
      "permanent": true
    },
    {
      "source": "/shodash/:id",
      "destination": "/shodash-geet/:id",
      "permanent": true
    },
    {
      "source": "/jayanti/:id",
      "destination": "/bhaiji-jayanti/:id",
      "permanent": true
    },
    {
      "source": "/kallolini/:id",
      "destination": "/mahabhav-kallolini/:id",
      "permanent": true
    },
    {
      "source": "/rkk/1",
      "destination": "/radhakripakataksh",
      "permanent": true
    },
    {
      "source": "/radhakripakataksh/1",
      "destination": "/radhakripakataksh",
      "permanent": true
    }
  ]
}
