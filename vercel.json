{
  "headers": [
    {
      "source": "/audio/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Type",
          "value": "audio/mpeg"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/pad/:id",
      "destination": "/index.html"
    },
    {
      "source": "/shodash/:id",
      "destination": "/index.html"
    },
    {
      "source": "/jayanti/:id",
      "destination": "/index.html"
    },
    {
      "source": "/kallolini/:id",
      "destination": "/index.html"
    },
    {
      "source": "/rkk/:id",
      "destination": "/index.html"
    }
  ]
}
