{
  "title": "श्रीराधाकृपाकटाक्ष (हिन्दी अनुवाद)",
  "language": "hi",
  "source": {
    "file": "source/booklet.pdf",
    "sha256": "3f54479b935518d0bf3bd5dfa0ea5f16b82faa3d81c6adba0a3b816e42a6e181",
    "pageCount": 16,
    "method": "Hindi translation only, directly checked against supplied page scans; Sanskrit originals and English translations omitted",
    "status": "assistant-source-checked"
  },
  "stanzas": [
    {
      "number": 1,
      "sourcePage": 1,
      "lines": [
        "लोक-त्रय-शोक-निवारिणि जो,",
        "मुनिजन करते जिनका वन्दन।",
        "करती निकुञ्जमें जो विलास,",
        "अम्बुज-सा जिनका विकच वदन॥",
        "वृषभानु-लली, ब्रजपति-किशोरसे",
        "रहता जिनका नित्य मिलन।",
        "कब कृपा कटाक्षोंमें भरकर",
        "फेरेंगी मेरी ओर नयन॥१॥"
      ]
    },
    {
      "number": 2,
      "sourcePage": 2,
      "lines": [
        "जिनका अशोककी छायामें,",
        "वल्लरी-वितान तले आसन।",
        "किसलय-कोमल, मूँगेकी आभा-",
        "मय जिनके मृदु-अरुण चरन॥",
        "वर-अभय-दानको उत्सुक कर,",
        "जो सदा सकल सम्पदा सदन।",
        "कब कृपा कटाक्षोंमें भरकर",
        "फेरेंगी मेरी ओर नयन॥२॥"
      ]
    },
    {
      "number": 3,
      "sourcePage": 3,
      "lines": [
        "बाँकी भृकुटीमें काम-नटीके",
        "मंगलमय नव-नव नर्तन,",
        "सुन्दर विभ्रम, संभ्रम सुचारु",
        "संवलित दृगोंके शर-पातन-",
        "से जिनके, प्रीति-प्रतीति भरे",
        "वशमें सदैव हैं नँदनंदन।",
        "कब कृपा कटाक्षोंमें भरकर",
        "फेरेंगी मेरी ओर नयन॥३॥"
      ]
    },
    {
      "number": 4,
      "sourcePage": 4,
      "lines": [
        "चपला-चामीकर-चम्पक-सी",
        "जिनके तनकी आभा उज्ज्वल।",
        "मुखकी शोभासे कोटि-कोटि",
        "जित-लज्जित शारद-शशिमण्डल॥",
        "नाना अनुपम क्रीड़ावाले,",
        "जिनके चकोर-शिशु-से लोचन।",
        "कब कृपा कटाक्षोंमें भरकर",
        "फेरेंगी मेरी ओर नयन॥४॥"
      ]
    },
    {
      "number": 5,
      "sourcePage": 5,
      "lines": [
        "मदमत्त दिव्य यौवनकी श्री,",
        "आमोद-मानसे हैं मण्डित।",
        "प्रिय-प्रेम-रंगमें रँगी हुई,",
        "हैं सकल-विलास-कला-पण्डित॥",
        "जो धन्य-अनन्य निकुञ्ज-राज्यमें",
        "काम-कला-विज्ञान-अयन।",
        "कब कृपा कटाक्षोंमें भरकर",
        "फेरेंगी मेरी ओर नयन॥५॥"
      ]
    },
    {
      "number": 6,
      "sourcePage": 6,
      "lines": [
        "प्रति हाव-भावकी उदधि धीर,",
        "हीरेका उरपर हार सुघर।",
        "कञ्चनके भारी कलशोंसे करि-",
        "कुम्भ-सदृश कुच-युग सुन्दर॥",
        "मुसकान मनोहर मन्द-मन्द,",
        "सुख-सुषमाकी जो सिंधु गहन।",
        "कब कृपा कटाक्षोंमें भरकर",
        "फेरेंगी मेरी ओर नयन॥६॥"
      ]
    },
    {
      "number": 7,
      "sourcePage": 7,
      "lines": [
        "अरविन्द-नाल-सी जल-प्रवाहमें",
        "लहराती भुज-लता युगल।",
        "चल लता-शिखर सम-लोल, असित",
        "नयनोंका अवलोकन-कौशल॥",
        "सुन्दर क्रीड़ा-चापल्य-मिलन-",
        "वाले जिनके आश्रित मोहन।",
        "कब कृपा कटाक्षोंमें भरकर",
        "फेरेंगी मेरी ओर नयन॥७॥"
      ]
    },
    {
      "number": 8,
      "sourcePage": 8,
      "lines": [
        "शोभा त्रिरेखकी कम्बु-कण्ठमें,",
        "जहाँ कनक-माला न्यारी।",
        "रत्नत्रय-दीप्तरश्मियोंसे",
        "मण्डित त्रिसूत्र मंगलकारी॥",
        "नागिन-सी काली लहराती",
        "वेणीमें जिनके गुँथे सुमन।",
        "कब कृपा कटाक्षोंमें भरकर",
        "फेरेंगी मेरी ओर नयन॥८॥"
      ]
    },
    {
      "number": 9,
      "sourcePage": 9,
      "lines": [
        "मेखला पुष्पकी लोट रही",
        "पृथु-गोल नितम्बोंके ऊपर।",
        "किंकिणी मनोरम रत्नोंकी",
        "मञ्जुल कटिमें करती सुस्वर॥",
        "जिनके सुषमामय ऊरु-युगलकी",
        "करिवर-कर-सी सुठि सुघरन।",
        "कब कृपा कटाक्षोंमें भरकर",
        "फेरेंगी मेरी ओर नयन॥९॥"
      ]
    },
    {
      "number": 10,
      "sourcePage": 10,
      "lines": [
        "जिनके नूपुरकी रुनझुनमें",
        "नाना मन्त्रोंका मधुर गान।",
        "है जिससे राजमरालोंके",
        "कल कूजनका भी मिटा मान॥",
        "गतिशील हेमकी लता सदृश,",
        "जिनका अति सुन्दर पद-क्षेपन।",
        "कब कृपा कटाक्षोंमें भरकर",
        "फेरेंगी मेरी ओर नयन॥१०॥"
      ]
    },
    {
      "number": 11,
      "sourcePage": 11,
      "lines": [
        "स्वामिनी अमित वैकुण्ठोंकी",
        "श्रीलक्ष्मी शीश झुकाती हैं।",
        "शैलेन्द्र-सुता, शारदा, शची",
        "जिनके हाथों वर पाती हैं॥",
        "जिनके मन-हरण चरण-नखसे",
        "सम्पूर्ण सिद्धिका संवर्द्धन।",
        "कब कृपा कटाक्षोंमें भरकर",
        "फेरेंगी मेरी ओर नयन॥११॥"
      ]
    },
    {
      "number": 12,
      "sourcePage": 12,
      "lines": [
        "यज्ञोंकी, क्रिया, स्वधाकी भी",
        "ईश्वरी समस्त सुधाशनकी।",
        "स्वामिनी त्रिवेदोंकी वाणीकी,",
        "न्याय-निरूपित दर्शनकी॥",
        "हे रमेश्वरि, वसुधेश्वरि हे,",
        "स्वामिनि प्रमोद-वनकी ललाम।",
        "ब्रजकी स्वामिनि, ब्रजकी रानी,",
        "श्रीराधे! तुमको है प्रणाम॥१२॥"
      ]
    },
    {
      "number": 13,
      "sourcePage": 13,
      "lines": [
        "वृषभानु-नन्दिनी श्रीराधे सुन",
        "अद्भुत यह निज कीर्ति-कथन।",
        "लें बना सदाके लिये दास-",
        "को कृपा-कटाक्षोंका भाजन॥",
        "तत्क्षण संचित तीनों प्रकारके",
        "कर्म भस्मवत् हों अशेष।",
        "ब्रजनन्दनकी लीलाओंमें मिल",
        "जाये जनको फिर प्रवेश॥१३॥"
      ]
    },
    {
      "number": 14,
      "sourcePage": 14,
      "lines": [
        "त्रयोदशी, एकादशी, दशमी, शुक्ला आठ।",
        "राकाको साधक सुधी करे शुद्ध मन पाठ॥१४॥"
      ]
    },
    {
      "number": 15,
      "sourcePage": 14,
      "lines": [
        "अपने वाञ्छित फल सभी पाये साधक व्यक्ति।",
        "राधा-कृपा-कटाक्षसे, प्रेम-लक्षणा भक्ति॥१५॥"
      ]
    },
    {
      "number": 16,
      "sourcePage": 15,
      "lines": [
        "ऊरु, नाभि, हिय, कण्ठतक, राधाकुण्ड मँझार।",
        "अङ्ग डुबाए सलिलमें, पढ़ता जो सौ बार॥१६॥"
      ]
    },
    {
      "number": 17,
      "sourcePage": 15,
      "lines": [
        "हों सब इच्छा पूर्ण, हो वचन सिद्धि तत्काल।",
        "विभव मिले, दे राधिका दर्शन करे निहाल॥१७॥"
      ]
    },
    {
      "number": 18,
      "sourcePage": 15,
      "lines": [
        "रीझ तुरत देती अतुल वर राधिका कृपाल।",
        "हो जाते सम्मुख प्रकट प्रिय उनके नँदलाल॥१८॥"
      ]
    },
    {
      "number": 19,
      "sourcePage": 16,
      "lines": [
        "ब्रजपति देते नित्यकी निज लीलामें ठौर।",
        "नहीं वैष्णवोंके लिये इससे बढ़ कुछ और॥१९॥"
      ]
    }
  ]
}
